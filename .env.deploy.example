# ═════════════════════════════════════════════════════════════════════
# Elmira Davet - Production FTP / SFTP Dağıtım (Deploy) Ayarları
# ═════════════════════════════════════════════════════════════════════
# Bu dosyayı '.env.deploy' olarak kopyalayın ve Natro FTP bilgilerinizi girin.
# DİKKAT: '.env.deploy' dosyası şifre içerdiği için git'e gönderilmez (.gitignore'dadır).

# ─── FTP Sunucu Bilgileri (Natro DNS Kayıtlarınıza Göre Hazırlanmıştır) ───
FTP_HOST=ftp.elmiradavet.com.tr
# Alternatif IP: 94.73.151.149
FTP_PORT=21
FTP_USER=your_ftp_username
FTP_PASSWORD=your_ftp_password

# FTPS (Güvenli FTP): true veya false (Natro FTPS destekliyorsa true önerilir)
FTP_SECURE=false

# ─── Sunucu Hedef Dizinleri ───
# cPanel/Linux hosting için genellikle '/public_html' veya '/httpdocs'
FTP_REMOTE_ROOT=/public_html

# PHP Backend REST API dizini (alt klasör ise: /public_html/api)
FTP_BACKEND_DIR=/public_html/api

# Next.js Frontend hedef dizini
FTP_FRONTEND_DIR=/public_html

# ─── Dağıtım Tercihleri ───
# Hedef: 'all' (Hem Frontend hem Backend), 'frontend' veya 'backend'
DEPLOY_TARGET=all

# Deploy öncesi otomatik 'npm run build' çalıştırılsın mı? (true/false)
BUILD_BEFORE_DEPLOY=true
