// Prisma Schema for Elmira Davet
// Wedding/Event Venue Management System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth & Users ────────────────────────────────────────

enum Role {
  ADMIN
  EDITOR
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(EDITOR)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  pages         Page[]
  pageRevisions PageRevision[]
  pageLocks     PageLock[]

  @@map("users")
}

// ─── Site Settings ───────────────────────────────────────

model SiteSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String @db.Text

  @@map("site_settings")
}

// ─── Hero Slides ─────────────────────────────────────────

model HeroSlide {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  imageUrl    String
  imagePublicId String?
  buttonText  String?
  buttonLink  String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("hero_slides")
}

// ─── Packages ────────────────────────────────────────────

model Package {
  id          String           @id @default(cuid())
  name        String
  slug        String           @unique
  description String           @db.Text
  price       Decimal?         @db.Decimal(10, 2)
  priceLabel  String?          // e.g. "Fiyat için arayınız"
  imageUrl    String?
  imagePublicId String?
  isActive    Boolean          @default(true)
  isFeatured  Boolean          @default(false)
  sortOrder   Int              @default(0)
  features    PackageFeature[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("packages")
}

model PackageFeature {
  id        String  @id @default(cuid())
  text      String
  sortOrder Int     @default(0)
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@map("package_features")
}

// ─── Gallery ─────────────────────────────────────────────

model GalleryCategory {
  id        String         @id @default(cuid())
  name      String
  slug      String         @unique
  sortOrder Int            @default(0)
  images    GalleryImage[]
  createdAt DateTime       @default(now())

  @@map("gallery_categories")
}

model GalleryImage {
  id            String          @id @default(cuid())
  title         String?
  alt           String
  imageUrl      String
  imagePublicId String?
  width         Int?
  height        Int?
  sortOrder     Int             @default(0)
  categoryId    String
  category      GalleryCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())

  @@map("gallery_images")
}

// ─── Blog ────────────────────────────────────────────────

enum PostStatus {
  DRAFT
  PUBLISHED
}

model BlogPost {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  excerpt       String?    @db.Text
  content       String     @db.Text
  coverImageUrl String?
  coverImagePublicId String?
  status        PostStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@map("blog_posts")
}

// ─── Testimonials ────────────────────────────────────────

model Testimonial {
  id        String   @id @default(cuid())
  name      String
  eventType String?  // e.g. "Düğün", "Nişan"
  content   String   @db.Text
  rating    Int      @default(5)
  imageUrl  String?
  imagePublicId String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@map("testimonials")
}

// ─── Reservations ────────────────────────────────────────

enum ReservationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Reservation {
  id              String            @id @default(cuid())
  fullName        String
  email           String
  phone           String
  eventDate       DateTime
  eventType       String
  guestCount      Int?
  message         String?           @db.Text
  status          ReservationStatus @default(PENDING)
  kvkkConsent     Boolean           @default(false)
  kvkkConsentDate DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@map("reservations")
}

// ─── Blocked Dates (Calendar) ────────────────────────────

model BlockedDate {
  id    String   @id @default(cuid())
  date  DateTime @unique
  note  String?  // e.g. "Ahmet & Ayşe Düğünü"

  @@map("blocked_dates")
}

// ─── KVKK Consent Records ───────────────────────────────

model KvkkConsent {
  id          String   @id @default(cuid())
  fullName    String
  email       String
  consentText String   @db.Text
  ipAddress   String?
  userAgent   String?  @db.Text
  consentDate DateTime @default(now())

  @@map("kvkk_consents")
}

// ─── Page SEO ────────────────────────────────────────────

model PageSeo {
  id              String @id @default(cuid())
  pageSlug        String @unique // e.g. "anasayfa", "galeri", "paketler"
  metaTitle       String
  metaDescription String @db.Text
  ogImageUrl      String?

  @@map("page_seo")
}

// ─── Pages & Block CMS (WordPress Architecture) ──────────

enum PageStatus {
  DRAFT
  PENDING_REVIEW
  SCHEDULED
  PUBLISHED
  TRASH
}

enum RevisionType {
  AUTOSAVE
  MANUAL
  PUBLISH
  RESTORE
}

model Page {
  id              String         @id @default(cuid())
  title           String
  slug            String         @unique
  status          PageStatus     @default(DRAFT)
  parentId        String?
  parent          Page?          @relation("PageHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Page[]         @relation("PageHierarchy")
  template        String         @default("default") // default, home, hall_detail, contact
  menuOrder       Int            @default(0)
  isSystem        Boolean        @default(false)     // anasayfa, iletisim, rezervasyon silinemez
  systemKey       String?        @unique             // "home", "contact", "reservation"
  content         Json           // BlockNode[] tree
  schemaVersion   Int            @default(1)
  version         Int            @default(1)         // Optimistic concurrency control
  featuredImageId String?
  seo             Json?          // { title, description, ogImage, canonical, noIndex, noFollow }
  authorId        String?
  author          User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)
  publishedAt     DateTime?
  scheduledAt     DateTime?
  trashedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  revisions       PageRevision[]
  locks           PageLock[]
  redirects       Redirect[]
  previewTokens   PreviewToken[]

  @@index([status, scheduledAt])
  @@index([slug])
  @@map("pages")
}

model PageRevision {
  id        String       @id @default(cuid())
  pageId    String
  page      Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title     String
  content   Json         // BlockNode[] snapshot
  authorId  String?
  author    User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  type      RevisionType @default(MANUAL)
  createdAt DateTime     @default(now())

  @@index([pageId, createdAt])
  @@map("page_revisions")
}

model PageLock {
  id        String   @id @default(cuid())
  pageId    String   @unique
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName  String
  expiresAt DateTime

  @@map("page_locks")
}

model Redirect {
  id         String   @id @default(cuid())
  fromPath   String   @unique
  toPath     String
  statusCode Int      @default(301)
  pageId     String?
  page       Page?    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@map("redirects")
}

model SavedBlock {
  id        String   @id @default(cuid())
  name      String
  category  String   @default("custom")
  content   Json     // Single BlockNode or BlockNode[]
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("saved_blocks")
}

model PreviewToken {
  id         String    @id @default(cuid())
  pageId     String
  page       Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@map("preview_tokens")
}

