# Veritabanı Bağlantı Bilgileri (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=elmira_davet
DB_USER=root
DB_PASS=

# JWT Gizli Anahtarı (Güçlü rastgele bir string girin)
JWT_SECRET=elmira_super_secret_jwt_key_2026_davet_salonu_token_key!

# İzin Verilen CORS Origin (Next.js frontend adresi)
# Geliştirme için: http://localhost:3000
# Canlı için: https://elmiradavet.com,https://admin.elmiradavet.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Dosya Yükleme Yolu (Göreceli veya Mutlak)
UPLOAD_DIR=public/uploads
UPLOAD_MAX_SIZE=10485760 # 10MB
