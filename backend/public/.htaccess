<IfModule mod_rewrite.c>
    RewriteEngine On

    # Eğer istek doğrudan gerçek bir dosya veya klasöre değilse index.php'ye yönlendir
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Güvenlik: .env dosyalarına ve gizli dosyalara erişimi engelle
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>
